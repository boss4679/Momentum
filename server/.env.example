# Copy to server/.env for running the API outside Docker (npm run dev / npm test).
# These match the Postgres container in docker-compose.yml, which publishes port 5432.
PORT=4000
DATABASE_URL=postgres://momentum:momentum@localhost:5432/momentum
TEST_DATABASE_URL=postgres://momentum:momentum@localhost:5432/momentum_test

# Signs the JWT access tokens. Use a long random value outside local development, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRES_IN=1h
